function enlazarDetalle(){const c=conflictos.find(x=>x.codigo===CASO_ACTIVO);if(!c)return;if($("admitir"))$("admitir").onclick=async()=>{if($("aCompetencia").value!=="SI")return alert("Debe confirmarse que la Entidad es competente.");if(!$("aClasificacion").value)return alert("Clasifique el asunto.");c.analisis_preliminar={competencia_entidad:true,requiere_tratamiento_formal:true,clasificacion:$("aClasificacion").value,observaciones:txt($("aObs").value),analizado_por:sesion.codigo,fecha:ahora()};c.estado="PENDIENTE_INSTRUCTOR";hist(c,"ADMISIÓN","Asunto admitido a tratamiento formal");await guardar();pintarTodo();abrirCaso(c.codigo)};if($("noAdmitir"))$("noAdmitir").onclick=async()=>{if(!txt($("aObs").value))return alert("Debe motivarse la no admisión.");c.analisis_preliminar={competencia_entidad:$("aCompetencia").value==="SI",requiere_tratamiento_formal:false,clasificacion:$("aClasificacion").value,observaciones:txt($("aObs").value),analizado_por:sesion.codigo,fecha:ahora()};c.estado="NO_ADMITIDO";hist(c,"NO ADMISIÓN",txt($("aObs").value));await guardar();pintarTodo();abrirCaso(c.codigo)};document.querySelectorAll(".elegirInstructor").forEach(b=>b.onclick=()=>comprobarInstructor(b.dataset.codigo));if($("guardarInvestigacion"))$("guardarInvestigacion").onclick=async()=>{c.investigacion.actuaciones=txt($("iAct").value);c.investigacion.conclusiones=txt($("iCon").value);c.documentos.push(...await subirDocs([...$("iDocs").files],c.codigo,"INVESTIGACION"));hist(c,"INVESTIGACIÓN","Actuaciones actualizadas");await guardar();abrirCaso(c.codigo);msg("Investigación guardada")};if($("abrirAudiencia"))$("abrirAudiencia").onclick=async()=>{if(!txt($("iCon").value))return alert("El instructor debe formular conclusiones provisionales.");c.investigacion.actuaciones=txt($("iAct").value);c.investigacion.conclusiones=txt($("iCon").value);c.estado="AUDIENCIA";hist(c,"AUDIENCIA","Se abre audiencia a las partes");await guardar();pintarTodo();abrirCaso(c.codigo)};if($("cerrarAudiencia"))$("cerrarAudiencia").onclick=async()=>{if(!$("auGarantia").checked)return alert("Debe confirmarse la garantía de audiencia.");c.audiencia={realizada:true,fecha:$("auFecha").value,alegaciones:txt($("auAleg").value),documentos:[...(c.audiencia?.documentos||[]),...await subirDocs([...$("auDocs").files],c.codigo,"AUDIENCIA")]};hist(c,"AUDIENCIA CERRADA","Derechos de audiencia garantizados");await guardar();abrirCaso(c.codigo)};if($("resolverPrimera"))$("resolverPrimera").onclick=async()=>{if(!$("rResultado").value||!txt($("rMot").value))return alert("La resolución debe contener resultado y motivación.");c.resolucion_primera={resultado:$("rResultado").value,motivacion:txt($("rMot").value),medidas:txt($("rMed").value),fecha:ahora(),resuelto_por:sesion.codigo};c.estado="RESUELTO_1I";hist(c,"RESOLUCIÓN 1ª INSTANCIA",$("rResultado").value);await guardar();pintarTodo();abrirCaso(c.codigo)};if($("presentarRecurso"))$("presentarRecurso").onclick=()=>{$("formRecurso").innerHTML=`<div class="bloque"><div class="campo"><label>Motivo</label><textarea id="recMot"></textarea></div><div class="campo"><label>Documentación</label><input id="recDocs" type="file" multiple></div><button class="btn btn-naranja" id="guardarRecurso">ELEVAR A REVISIÓN INTERNA</button></div>`;$("guardarRecurso").onclick=async()=>{if(!txt($("recMot").value))return alert("Debe registrarse el motivo.");c.recurso={presentado:true,fecha:ahora(),motivo:txt($("recMot").value),documentos:await subirDocs([...$("recDocs").files],c.codigo,"RECURSO"),estado:"PRESENTADO"};c.estado="COMITE_PARTES";hist(c,"RECURSO INTERNO",c.recurso.motivo);hist(c,"ELEVACIÓN","Expediente elevado al Comité de Partes");await guardar();pintarTodo();abrirCaso(c.codigo)}};if($("resolverComite"))$("resolverComite").onclick=async()=>{if(!txt($("coDecision").value)||!txt($("coMot").value))return alert("El Comité debe registrar decisión y motivación.");c.comite={intervencion:true,fecha:$("coFecha").value,composicion:txt($("coComp").value),decision:txt($("coDecision").value),motivacion:txt($("coMot").value)};c.estado="VIA_INTERNA_AGOTADA";hist(c,"COMITÉ DE PARTES","Decisión final interna registrada");await guardar();pintarTodo();abrirCaso(c.codigo)};if($("iniciarExterna"))$("iniciarExterna").onclick=()=>{$("formExterna").innerHTML=`<div class="bloque"><div class="form-grid"><div class="campo"><label>Vía externa</label><select id="exTipo"><option>MEDIACIÓN PROFESIONAL</option><option>ARBITRAJE</option><option>VÍA JUDICIAL</option><option>OTRA</option></select></div><div class="campo"><label>Fecha</label><input id="exFecha" type="date" value="${hoy()}"></div><div class="campo ancho"><label>Referencia / órgano / observaciones</label><textarea id="exRef"></textarea></div></div><button class="btn btn-naranja" id="guardarExterna">REGISTRAR VÍA EXTERNA</button></div>`;$("guardarExterna").onclick=async()=>{c.via_externa={iniciada:true,tipo:$("exTipo").value,fecha:$("exFecha").value,referencia:txt($("exRef").value),resultado:""};c.estado="VIA_EXTERNA";hist(c,"VÍA EXTERNA",c.via_externa.tipo);await guardar();pintarTodo();abrirCaso(c.codigo)}};if($("cerrarCaso"))$("cerrarCaso").onclick=async()=>{if(!txt($("clResultado").value))return alert("Debe indicar el resultado final.");c.cierre={fecha:ahora(),resultado_final:txt($("clResultado").value),causa_raiz:txt($("clCausa").value),medidas_preventivas:txt($("clPrev").value),seguimiento:txt($("clSeg").value),responsable:txt($("clResp").value)};c.estado="CERRADO";hist(c,"CIERRE","Expediente cerrado");await guardar();pintarTodo();abrirCaso(c.codigo);msg("Expediente cerrado")}}
function comprobarInstructor(codigo){const c=conflictos.find(x=>x.codigo===CASO_ACTIVO),p=personas.find(x=>x.codigo===codigo);if(!c||!p)return;$("comprobacionInstructor").innerHTML=`<div class="bloque"><h3>Comprobación ad hoc · ${p.nombre}</h3><div class="datos"><div class="dato"><b>Competencia</b>${p.competencia?.validada?"VALIDADA":"NO VALIDADA"}</div><div class="dato"><b>Habilitación</b>${p.habilitacion}</div><div class="dato"><b>Declaración general</b>${p.declaracion_independencia?.aceptada?"VIGENTE":"NO CONSTA"}</div></div><label class="check"><input id="ci1" type="checkbox"><span>He revisado la información declarada y no identifico relación conocida que comprometa su independencia.</span></label><label class="check"><input id="ci2" type="checkbox"><span>La persona declara específicamente que no conoce ninguna circunstancia adicional que comprometa su independencia.</span></label><div class="campo ancho" style="margin-top:15px"><label>Observaciones</label><textarea id="ciObs"></textarea></div><button class="btn btn-verde" id="confirmarInstructor">DESIGNAR INSTRUCTOR</button></div>`;$("confirmarInstructor").onclick=async()=>{if(!$("ci1").checked||!$("ci2").checked)return alert("Debe completar ambas comprobaciones.");c.instructor={codigo_persona:p.codigo,nombre:p.nombre,fecha_designacion:ahora(),competencia_comprobada:true,independencia_comprobada:true,declaracion_adhoc:true,declaracion_texto:txt($("ciObs").value)};c.estado="EN_INVESTIGACION";hist(c,"DESIGNACIÓN DE INSTRUCTOR",p.nombre+" · competencia e independencia comprobadas ad hoc");await guardar();pintarTodo();abrirCaso(c.codigo);msg("Instructor designado")}}
function pintarInstructores(){const e=elegibles(),todos=personas.filter(p=>(p.funciones||[]).includes("INSTRUCTOR_CONFLICTOS"));$("listaInstructores").innerHTML=todos.length?todos.map(p=>{const ok=e.some(x=>x.codigo===p.codigo);return`<div class="instructor-card ${ok?"":"no-apto"}"><div><strong>${p.nombre}</strong><br><span>${p.codigo} · ${p.entidad||""}</span></div><span>${p.competencia?.validada?"Competencia validada":"Competencia pendiente"}</span><span>${p.habilitacion||"Sin habilitación"}</span><span class="estado ${ok?"verde":"rojo"}">${ok?"ELEGIBLE":"NO ELEGIBLE"}</span></div>`}).join(""):'<div class="vacio">No existen personas con la función INSTRUCTOR_CONFLICTOS.</div>'}function pintarPreventivas(){const l=conflictos.filter(c=>txt(c.cierre?.medidas_preventivas));$("listaPreventivas").innerHTML=l.length?l.map(c=>`<div class="bloque"><strong>${c.codigo}</strong> · ${origen(c.origen)}<div class="aviso ok">${c.cierre.medidas_preventivas}</div></div>`).join(""):'<div class="vacio">Todavía no existen medidas preventivas derivadas de expedientes cerrados.</div>'}function pintarTodo(){pintarIndicadores();pintarCasos()}async function iniciar(){try{[conflictos,personas]=await Promise.all([descargar(BASE+ARCHIVO,"conflictos"),descargar(BASE+ARCHIVO_PERSONAS,"personas")]);if(!Array.isArray(conflictos))conflictos=[];if(!Array.isArray(personas))personas=[];pintarTodo()}catch(e){console.error(e);alert("No se ha podido iniciar A6:\n\n"+e.message)}}iniciar();
</script></body></html>
